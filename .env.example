# Build-time config (set these in Vercel -> Project -> Settings -> Environment Variables).
# Both are optional: the app also has a Settings panel where they can be typed in.
# Shape only, never put real secrets in this file.

# HTTPS origin of the deployed backend. No trailing slash, no /v1.
API_BASE_URL=https://<your-render-service>.onrender.com

# Sensor key (same value as SENSOR_API_KEY on the backend).
# NOTE: anything shipped to a browser is not a secret (constitution section 11).
SENSOR_KEY=
